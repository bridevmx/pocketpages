{
  "name": "pocketpages-monorepo",
  "private": true,
  "devDependencies": {
    "@changesets/cli": "^2.28.0",
    "concurrently": "^9.1.2",
    "prettier": "^3.5.1",
    "prettier-plugin-organize-imports": "^4.1.0",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "dev": "bun run --filter='*' dev",
    "build": "bun run --filter='*' build",
    "deploy": "bun run --filter='*' deploy",
    "publish": "concurrently 'bun:publish:*'",
    "publish:pocketpages": "cd packages/pocketpages && bun publish",
    "publish:auth": "cd packages/plugins/auth && bun publish",
    "publish:ejs": "cd packages/plugins/ejs && bun publish",
    "publish:js-sdk": "cd packages/plugins/js-sdk && bun publish",
    "publish:micro-dash": "cd packages/plugins/micro-dash && bun publish",
    "publish:realtime": "cd packages/plugins/realtime && bun publish",
    "publish:create-pocketpages": "cd packages/create-pocketpages && bun publish",
    "publish:datastar": "cd packages/plugins/datastar && bun publish",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "publish:forms": "cd packages/plugins/forms && bun publish",
    "publish:i18n": "cd packages/plugins/i18n && bun publish",
    "publish:page-cache": "cd packages/plugins/page-cache && bun publish",
    "publish:pagination": "cd packages/plugins/pagination && bun publish",
    "publish:rbac": "cd packages/plugins/rbac && bun publish",
    "publish:security": "cd packages/plugins/security && bun publish",
    "publish:seo": "cd packages/plugins/seo && bun publish",
    "publish:session": "cd packages/plugins/session && bun publish"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "semi": false,
    "plugins": [
      "prettier-plugin-organize-imports"
    ]
  },
  "workspaces": [
    "packages/*",
    "packages/plugins/*",
    "packages/starters/*"
  ]
}
